# База региона Lâm Đồng (Supabase region-lamdong, ref umhoqwhjcjmajcloijvl).
# Нужна только для `npm run pull`. Сборка и деплой берут закоммиченный
# src/data/vietnam.generated.ts и в базу не ходят.
#
# У всех таблиц базы включён RLS и ноль политик: анонимный ключ вернёт пустые
# массивы. Читать надо сервисным ключом.
# Значения лежат в ~/.hermes/profiles/producer-space/.env
REGION_SUPABASE_URL=https://umhoqwhjcjmajcloijvl.supabase.co
REGION_SUPABASE_SERVICE_KEY=
REGION_SUPABASE_ANON_KEY=
